---
import { getEntry } from 'astro:content';

import AboutFrcPage from '../components/AboutFrcPage.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [siteEntry, aboutFrcEntry] = await Promise.all([
  getEntry('site', 'site'),
  getEntry('aboutFrc', 'aboutFrc'),
]);

if (!siteEntry || !aboutFrcEntry) {
  throw new Error('The About FRC page content is incomplete.');
}

const site = siteEntry.data;
const aboutFrc = aboutFrcEntry.data;
const sectionIds = [
  'about-frc',
  'about-xplore',
  'about-gh-frc',
  'robots',
  'achievements',
  'news',
  'sponsors',
  'contact',
] as const;
const navigationItems = sectionIds.map((id) => ({
  href: id === 'about-frc' ? '/about-frc/' : `/#${id}`,
  label: site.navigation[id],
  isCurrent: id === 'about-frc',
}));
---

<BaseLayout
  title={aboutFrc.meta.title}
  description={aboutFrc.meta.description}
  language={site.language}
>
  <SiteHeader
    logo={site.logo}
    navigationItems={navigationItems}
    mainNavigationLabel={site.accessibility.mainNavigation}
    homeLinkLabel={site.accessibility.returnToHome}
    switchToDarkModeLabel={site.accessibility.switchToDarkMode}
    switchToLightModeLabel={site.accessibility.switchToLightMode}
    homeHref="/"
  />

  <AboutFrcPage content={aboutFrc} />
  <SiteFooter title={site.footer.title} placeholder={site.footer.placeholder} />

  <script>
    import { initializeSiteInteractions } from '../scripts/site-interactions';

    initializeSiteInteractions();
  </script>
</BaseLayout>
