---
import { getCollection, getEntry } from 'astro:content';

import HomePage from '../components/HomePage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePagePlan } from '../site-structure';

const [siteEntry, pageEntries] = await Promise.all([
  getEntry('site', 'site'),
  getCollection('page'),
]);

if (!siteEntry) {
  throw new Error('The site content entry is missing.');
}

const pageEntryById = new Map(pageEntries.map((entry) => [entry.id, entry]));
const pages = sitePagePlan.map((plan) => {
  const entry = pageEntryById.get(plan.contentId);

  if (!entry || entry.data.navigationId !== plan.id || entry.data.order !== plan.order) {
    throw new Error(`The ${plan.contentId} page content is missing or assigned to the wrong navigation item.`);
  }

  return { id: plan.id, href: plan.href, page: entry.data };
});
const site = siteEntry.data;
---

<SiteLayout
  site={site}
  currentPage="home"
  title={site.title}
  description={site.description}
>
  <HomePage hero={site.hero} pages={pages} />

  <script>
    import { initializeOptionalAchievementSystem } from '../scripts/optional-achievements';
    import { redirectLegacySection } from '../scripts/legacy-navigation';

    if (!redirectLegacySection()) {
      void initializeOptionalAchievementSystem();
    }
  </script>
</SiteLayout>
