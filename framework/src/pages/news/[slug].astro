---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';

import EntryDetailPage from '../../components/EntryDetailPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

interface Props {
  entry: CollectionEntry<'news'>;
}

export async function getStaticPaths() {
  const entries = await getCollection('news');

  return entries.flatMap((entry) => (
    entry.data.entryType === 'news' && entry.data.published
      ? [{ params: { slug: entry.id }, props: { entry } }]
      : []
  ));
}

const { entry } = Astro.props;
const [siteEntry, newsPage] = await Promise.all([
  getEntry('site', 'site'),
  getEntry('page', 'news'),
]);

if (!siteEntry || !newsPage) {
  throw new Error('The news detail page content is incomplete.');
}

if (entry.data.entryType !== 'news') {
  throw new Error('A news guide entry cannot be rendered as a news detail page.');
}

const { Content } = await render(entry);
const site = siteEntry.data;
---

<SiteLayout
  site={site}
  currentPage="news"
  title={`${entry.data.title} | ${site.title}`}
  description={entry.data.description}
>
  <EntryDetailPage
    breadcrumbLabel={site.accessibility.breadcrumbNavigation}
    homeLabel={site.accessibility.homeLabel}
    sectionLabel={newsPage.data.hero.title}
    sectionHref="/news/"
    eyebrow={entry.data.publishedAt.toLocaleDateString('zh-CN')}
    title={entry.data.title}
    introduction={entry.data.summary}
    media={entry.data.cover}
    mediaLabel={entry.data.title}
  >
    <Content />
  </EntryDetailPage>
</SiteLayout>
