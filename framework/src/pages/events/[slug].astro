---
import { getCollection } from 'astro:content';

import LanguageRedirectPage from '../../components/LanguageRedirectPage.astro';

interface Props {
  pagePath: string;
}

export async function getStaticPaths() {
  const entries = await getCollection('event');

  return entries.flatMap((entry) => (
    entry.data.entryType === 'event' && entry.data.published
      ? [{
          params: { slug: entry.id },
          props: { pagePath: `events/${entry.id}` },
        }]
      : []
  ));
}

const { pagePath } = Astro.props;
---

<LanguageRedirectPage pagePath={pagePath} />
