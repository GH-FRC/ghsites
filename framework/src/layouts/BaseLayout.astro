---
import '../styles/global.css';

import { COLOR_SCHEME_BOOTSTRAP_SCRIPT } from '../scripts/color-scheme';
import { createLocaleVisitScript } from '../scripts/language-preference';
import {
  htmlLanguageForLocale,
  SUPPORTED_LOCALES,
  type Locale,
} from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  faviconLightSrc: string;
  faviconDarkSrc: string;
  locale: Locale;
  pagePath?: string;
  noIndex?: boolean;
  titleLanguage?: string;
  descriptionLanguage?: string;
}

const {
  title,
  description,
  faviconLightSrc,
  faviconDarkSrc,
  locale,
  pagePath = '',
  noIndex = false,
  titleLanguage,
  descriptionLanguage,
} = Astro.props;
const htmlLanguage = htmlLanguageForLocale(locale);
const normalizedPagePath = pagePath ? `${pagePath.replace(/^\/+|\/+$/g, '')}/` : '';
const canonicalUrl = new URL(`/${locale}/${normalizedPagePath}`, Astro.site ?? Astro.url);
const languageAlternates = SUPPORTED_LOCALES.map((alternateLocale) => ({
  href: new URL(`/${alternateLocale}/${normalizedPagePath}`, Astro.site ?? Astro.url),
  htmlLanguage: htmlLanguageForLocale(alternateLocale),
}));
const automaticUrl = new URL(`/${normalizedPagePath}`, Astro.site ?? Astro.url);
const shouldPreventIndexing = noIndex || import.meta.env.SITE_NOINDEX === 'true';
const languagePreferenceScript = createLocaleVisitScript(locale);
const faviconRevision = '20260831';
const versionFavicon = (src: string, variant: 'light' | 'dark') => (
  `${src}${src.includes('?') ? '&' : '?'}favicon=${faviconRevision}-${variant}`
);
const faviconLightHref = versionFavicon(faviconLightSrc, 'light');
const faviconDarkHref = versionFavicon(faviconDarkSrc, 'dark');
---

<!doctype html>
<html lang={htmlLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} lang={descriptionLanguage} />
    {shouldPreventIndexing && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      data-browser-theme-color
      data-light-color="#ffffff"
      data-dark-color="#000000"
    />
    <link
      rel="icon"
      type="image/png"
      href={faviconLightHref}
      data-browser-tab-icon
      data-light-icon={faviconLightHref}
      data-dark-icon={faviconDarkHref}
    />
    <link rel="canonical" href={canonicalUrl} />
    {
      languageAlternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.htmlLanguage} href={alternate.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={automaticUrl} />
    <script is:inline set:html={COLOR_SCHEME_BOOTSTRAP_SCRIPT}></script>
    <script is:inline set:html={languagePreferenceScript}></script>
    <title lang={titleLanguage}>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initializeBrowserTab } from '../scripts/browser-tab';

      initializeBrowserTab(document, window);
    </script>
    <script>
      import { initializeColorSchemeControl } from '../scripts/color-scheme';

      initializeColorSchemeControl(document, window);
    </script>
    <script>
      import { initializeLanguageSwitchLinks } from '../scripts/language-preference';

      initializeLanguageSwitchLinks();
    </script>
  </body>
</html>
