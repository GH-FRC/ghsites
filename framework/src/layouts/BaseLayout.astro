---
import '../styles/global.css';

import { COLOR_SCHEME_BOOTSTRAP_SCRIPT } from '../scripts/color-scheme';

interface Props {
  title: string;
  description: string;
  language: string;
}

const { title, description, language } = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={COLOR_SCHEME_BOOTSTRAP_SCRIPT}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initializeColorSchemeControl } from '../scripts/color-scheme';

      initializeColorSchemeControl(document, window);
    </script>
  </body>
</html>
