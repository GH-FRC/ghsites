---
import type { EventContent, PageContent, SiteContent } from '../content-schema';
import type { SitePageId } from '../site-structure';
import MediaFrame from './MediaFrame.astro';

interface HomePageItem {
  id: SitePageId;
  href: string;
  page: PageContent;
  fallbackPaths: ReadonlySet<string>;
}

interface Props {
  hero: SiteContent['hero'];
  heroFallbackPaths: ReadonlySet<string>;
  pages: HomePageItem[];
  placeholderKindLabel: string;
  placeholderKindLanguage?: string;
  featuredEvent?: {
    data: EventContent;
    href: string;
    label: string;
    linkLabel: string;
    upcomingLabel: string;
    ongoingLabel: string;
    pastLabel: string;
    timeLabel: string;
    venueLabel: string;
  };
}

const {
  hero,
  heroFallbackPaths,
  pages,
  placeholderKindLabel,
  placeholderKindLanguage,
  featuredEvent,
} = Astro.props;
const fallbackLanguage = (
  paths: ReadonlySet<string>,
  path: string,
) => paths.has(path) ? 'zh-CN' : undefined;
---

<main class="home-page" id="main-content">
  {
    featuredEvent ? (
      <section
        class="home-event-hero"
        id="page-top"
        data-featured-event={featuredEvent.data.title}
        data-event-status-container
        data-event-starts-at={featuredEvent.data.startsAt.toISOString()}
        data-event-ends-at={featuredEvent.data.endsAt.toISOString()}
        data-event-upcoming-label={featuredEvent.upcomingLabel}
        data-event-ongoing-label={featuredEvent.ongoingLabel}
        data-event-past-label={featuredEvent.pastLabel}
        data-scroll-section
      >
        <div class="home-event-hero__inner">
          <div class="home-event-hero__copy">
            <p class="home-event-hero__eyebrow" data-event-status-label>{featuredEvent.label}</p>
            <h1>{featuredEvent.data.title}</h1>
            <p class="home-event-hero__summary">{featuredEvent.data.summary}</p>
            <dl class="home-event-hero__facts">
              <div>
                <dt class="sr-only">{featuredEvent.timeLabel}</dt>
                <dd>
                  <time datetime={featuredEvent.data.startsAt.toISOString()}>
                    {featuredEvent.data.dateText}
                  </time>
                  <span>{featuredEvent.data.timeText}</span>
                </dd>
              </div>
              <div>
                <dt class="sr-only">{featuredEvent.venueLabel}</dt>
                <dd>{featuredEvent.data.venue}</dd>
              </div>
            </dl>
            <a class="home-event-hero__action" href={featuredEvent.href}>
              <span>{featuredEvent.linkLabel}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <figure class="home-event-hero__media">
            <img
              class="home-event-hero__backdrop"
              src={featuredEvent.data.cover.src}
              alt=""
              width={featuredEvent.data.cover.intrinsicWidth}
              height={featuredEvent.data.cover.intrinsicHeight}
              aria-hidden="true"
            />
            <img
              class="home-event-hero__artwork"
              src={featuredEvent.data.cover.src}
              alt={featuredEvent.data.cover.alt}
              width={featuredEvent.data.cover.intrinsicWidth}
              height={featuredEvent.data.cover.intrinsicHeight}
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </section>
    ) : (
      <section class="home-hero" id="page-top" data-scroll-section>
        <div class="home-hero__inner">
          <div class="home-hero__copy">
            <h1 lang={fallbackLanguage(heroFallbackPaths, 'hero.title')}>{hero.title}</h1>
            <p lang={fallbackLanguage(heroFallbackPaths, 'hero.introduction')}>
              {hero.introduction}
            </p>
          </div>
          <div class:list={[
            'home-hero__media',
            hero.media?.src.includes('/brand/ghfrc-logo-square-') && 'home-hero__media--brand',
          ]}>
            <MediaFrame
              media={hero.media}
              placeholderLabel={hero.mediaLabel}
              placeholderKindLabel={placeholderKindLabel}
              placeholderLanguage={fallbackLanguage(heroFallbackPaths, 'hero.mediaLabel')}
              placeholderKindLanguage={placeholderKindLanguage}
              mediaTextLanguage={fallbackLanguage(heroFallbackPaths, 'hero.media.alt')}
              eager
            />
          </div>
        </div>
      </section>
    )
  }

  {
    pages.map(({ id, href, page, fallbackPaths }, index) => (
      <section
        class:list={['home-showcase', index % 2 === 1 && 'home-showcase--reverse']}
        id={id}
        data-achievement-section={id}
        data-scroll-section
      >
        <div class="home-showcase__inner">
          <div class="home-showcase__copy">
            <span class="home-showcase__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h2 lang={fallbackLanguage(fallbackPaths, 'home.title')}>{page.home.title}</h2>
            <p lang={fallbackLanguage(fallbackPaths, 'home.summary')}>{page.home.summary}</p>
            <a
              class="text-link"
              href={href}
              lang={fallbackLanguage(fallbackPaths, 'home.linkLabel')}
            >
              <span>{page.home.linkLabel}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <a
            class="home-showcase__media-link"
            href={href}
            aria-label={page.home.title}
            lang={fallbackLanguage(fallbackPaths, 'home.title')}
          >
            <MediaFrame
              media={page.home.media}
              placeholderLabel={page.home.mediaLabel}
              placeholderKindLabel={placeholderKindLabel}
              placeholderLanguage={fallbackLanguage(fallbackPaths, 'home.mediaLabel')}
              placeholderKindLanguage={placeholderKindLanguage}
              mediaTextLanguage={fallbackLanguage(fallbackPaths, 'home.media.alt')}
            />
          </a>
        </div>
      </section>
    ))
  }
</main>

<script>
  import { initializeEventStatusLabels } from '../scripts/event-status';

  initializeEventStatusLabels();
</script>
