---
import MediaFrame from './MediaFrame.astro';

interface MediaReference {
  src: string;
  alt: string;
  intrinsicWidth: number;
  intrinsicHeight: number;
}

interface Props {
  breadcrumbLabel: string;
  homeLabel: string;
  sectionLabel: string;
  sectionHref: string;
  eyebrow: string;
  title: string;
  introduction: string;
  media?: MediaReference;
  mediaLabel: string;
}

const {
  breadcrumbLabel,
  homeLabel,
  sectionLabel,
  sectionHref,
  eyebrow,
  title,
  introduction,
  media,
  mediaLabel,
} = Astro.props;
---

<main class="entry-detail" id="main-content">
  <nav class="site-page__breadcrumb" aria-label={breadcrumbLabel}>
    <a href="/">{homeLabel}</a>
    <span aria-hidden="true">/</span>
    <a href={sectionHref}>{sectionLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>

  <header class="entry-detail__hero" id="page-top" data-scroll-section>
    <div>
      <p class="page-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{introduction}</p>
    </div>
    <MediaFrame media={media} placeholderLabel={mediaLabel} eager />
  </header>

  <article class="entry-detail__body site-page__prose" data-scroll-section>
    <slot />
  </article>
</main>
