---
type PlaceholderKind = 'text' | 'media' | 'item' | 'news' | 'sponsor' | 'contact';

interface Props {
  label: string;
  kind: PlaceholderKind;
  kindLabel: string;
  kindLabelLanguage?: string;
  labelLanguage?: string;
}

const { label, kind, kindLabel, kindLabelLanguage, labelLanguage } = Astro.props;
---

<div class:list={['placeholder', `placeholder--${kind}`]}>
  <span class="placeholder__kind" lang={kindLabelLanguage}>{kindLabel}</span>
  <p lang={labelLanguage}>{label}</p>

  {
    kind === 'text' && (
      <div class="placeholder__text-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    )
  }

  {
    (kind === 'media' || kind === 'news' || kind === 'sponsor') && (
      <div class="placeholder__cross" aria-hidden="true"></div>
    )
  }
</div>
