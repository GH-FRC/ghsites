---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'aboutFrc'>['data'];
}

const { content } = Astro.props;
---

<main class="about-frc-page" id="page-top">
  <nav class="about-frc-page__breadcrumb" aria-label="面包屑导航">
    <a href="/">{content.breadcrumb.homeLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{content.breadcrumb.currentLabel}</span>
  </nav>

  <header class="about-frc-hero" data-scroll-section>
    <div class="about-frc-hero__copy">
      <p class="about-frc-page__eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.title}</h1>
      <p class="about-frc-hero__introduction">{content.hero.introduction}</p>
    </div>
    <dl class="about-frc-hero__highlights">
      {content.hero.highlights.map((highlight) => (
        <div>
          <dt>{highlight.value}</dt>
          <dd>{highlight.label}</dd>
        </div>
      ))}
    </dl>
  </header>

  <section class="about-frc-page__section about-frc-page__section--overview" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.overview.eyebrow}</p>
      <h2>{content.overview.heading}</h2>
    </div>
    <div class="about-frc-page__prose about-frc-page__prose--large">
      {content.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="about-frc-page__section" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.competition.eyebrow}</p>
      <h2>{content.competition.heading}</h2>
      <p>{content.competition.introduction}</p>
    </div>
    <ol class="about-frc-page__stage-list">
      {content.competition.stages.map((stage) => (
        <li>
          <span>{stage.index}</span>
          <h3>{stage.heading}</h3>
          <p>{stage.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="about-frc-page__section about-frc-page__section--impact" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.impact.eyebrow}</p>
      <h2>{content.impact.heading}</h2>
    </div>
    <div class="about-frc-page__prose">
      {content.impact.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <dl class="about-frc-page__statistics">
      {content.impact.statistics.map((statistic) => (
        <div>
          <dt>{statistic.value}</dt>
          <dd>
            <strong>{statistic.label}</strong>
            <span>{statistic.context}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="about-frc-page__section" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.development.eyebrow}</p>
      <h2>{content.development.heading}</h2>
      <p>{content.development.introduction}</p>
    </div>
    <div class="about-frc-page__card-grid">
      {content.development.items.map((item) => (
        <article>
          <h3>{item.heading}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-frc-page__section" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.higherEducation.eyebrow}</p>
      <h2>{content.higherEducation.heading}</h2>
      <p>{content.higherEducation.introduction}</p>
    </div>
    <div>
      <ol class="about-frc-page__case-list">
        {content.higherEducation.cases.map((item) => (
          <li>
            <span>{item.year}</span>
            <div>
              <h3>{item.heading}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="about-frc-page__disclaimer">{content.higherEducation.disclaimer}</p>
    </div>
  </section>

  <section class="about-frc-page__section about-frc-page__section--scholarships" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.scholarships.eyebrow}</p>
      <h2>{content.scholarships.heading}</h2>
    </div>
    <div class="about-frc-page__scholarship-layout">
      <div class="about-frc-page__prose">
        {content.scholarships.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="about-frc-page__scholarship-highlight">
        <strong>{content.scholarships.highlight.value}</strong>
        <span>{content.scholarships.highlight.label}</span>
        <small>{content.scholarships.highlight.note}</small>
      </aside>
    </div>
  </section>

  <section class="about-frc-page__section about-frc-page__section--partners" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">{content.partners.eyebrow}</p>
      <h2>{content.partners.heading}</h2>
      <p>{content.partners.introduction}</p>
    </div>
    <ul class="about-frc-page__partner-grid" aria-label={content.partners.heading}>
      {content.partners.items.map((partner) => (
        <li data-surface={partner.surface ?? 'light'}>
          {partner.website ? (
            <a href={partner.website} target="_blank" rel="noreferrer">
              {partner.logo ? (
                <img
                  src={partner.logo.src}
                  alt={partner.logo.alt}
                  width={partner.logo.intrinsicWidth}
                  height={partner.logo.intrinsicHeight}
                  loading="lazy"
                />
              ) : (
                <span>{partner.name}</span>
              )}
            </a>
          ) : partner.logo ? (
            <img
              src={partner.logo.src}
              alt={partner.logo.alt}
              width={partner.logo.intrinsicWidth}
              height={partner.logo.intrinsicHeight}
              loading="lazy"
            />
          ) : (
            <span>{partner.name}</span>
          )}
        </li>
      ))}
    </ul>
    <p class="about-frc-page__disclaimer">{content.partners.disclaimer}</p>
  </section>

  <section class="about-frc-page__section about-frc-page__section--sources" data-scroll-section>
    <div class="about-frc-page__section-heading">
      <p class="about-frc-page__eyebrow">Sources</p>
      <h2>{content.sources.heading}</h2>
      <p>{content.sources.introduction}</p>
    </div>
    <ol class="about-frc-page__source-list">
      {content.sources.items.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
          <span>{source.organization}</span>
        </li>
      ))}
    </ol>
    <p class="about-frc-page__review-date">{content.sources.reviewedOn}</p>
  </section>
</main>
