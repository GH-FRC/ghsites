---
import type { CollectionEntry } from 'astro:content';

interface Props {
  state: NonNullable<CollectionEntry<'page'>['data']['emptyState']>;
  headingLevel?: 'h1' | 'h2';
}

const { state, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<div class="empty-state">
  <p class="page-eyebrow">{state.eyebrow}</p>
  <Heading>{state.title}</Heading>
  <p>{state.body}</p>
  {
    state.actionLabel && state.actionHref && (
      <a class="text-link" href={state.actionHref}>
        <span>{state.actionLabel}</span>
        <span aria-hidden="true">↗</span>
      </a>
    )
  }
</div>
