---
import type { CollectionEntry } from 'astro:content';

interface Props {
  state: NonNullable<CollectionEntry<'page'>['data']['emptyState']>;
}

const { state } = Astro.props;
---

<div class="empty-state">
  <p class="page-eyebrow">{state.eyebrow}</p>
  <h2>{state.title}</h2>
  <p>{state.body}</p>
  {
    state.actionLabel && state.actionHref && (
      <a class="text-link" href={state.actionHref}>
        <span>{state.actionLabel}</span>
        <span aria-hidden="true">↗</span>
      </a>
    )
  }
</div>
