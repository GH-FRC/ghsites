---
import PlaceholderBlock from './PlaceholderBlock.astro';

type SectionVariant =
  | 'split'
  | 'split-reverse'
  | 'overview'
  | 'feature'
  | 'grid'
  | 'news'
  | 'sponsors'
  | 'contact';

interface SectionContent {
  heading: string;
  bodyPlaceholder: string;
  mediaPlaceholder?: string;
  itemPlaceholders: string[];
}

interface Props {
  id: string;
  index: string;
  variant: SectionVariant;
  content: SectionContent;
}

const { id, index, variant, content } = Astro.props;

const itemKind = variant === 'news'
  ? 'news'
  : variant === 'sponsors'
    ? 'sponsor'
    : variant === 'contact'
      ? 'contact'
      : 'item';
---

<section
  class:list={['content-section', `content-section--${variant}`]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="content-section__inner">
    <header class="content-section__header">
      <span>{index}</span>
      <h2 id={`${id}-title`}>{content.heading}</h2>
    </header>

    <div class="content-section__body">
      <div class="content-section__introduction">
        <PlaceholderBlock label={content.bodyPlaceholder} kind="text" />
      </div>

      {
        content.mediaPlaceholder && (
          <div class="content-section__media">
            <PlaceholderBlock label={content.mediaPlaceholder} kind="media" />
          </div>
        )
      }

      {
        content.itemPlaceholders.length > 0 && (
          <div class="content-section__items">
            {content.itemPlaceholders.map((label) => (
              <PlaceholderBlock label={label} kind={itemKind} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
