---
import type { HtmlLanguage, Locale } from '../i18n/locales';

interface Props {
  currentLanguageLabel: string;
  currentLanguageName: string;
  currentShortLabel: string;
  navigationLabel: string;
  navigationLanguage?: string;
  options: Array<{
    href: string;
    htmlLanguage: HtmlLanguage;
    locale: Locale;
    languageName: string;
    shortLabel: string;
  }>;
}

const {
  currentLanguageLabel,
  currentLanguageName,
  currentShortLabel,
  navigationLabel,
  navigationLanguage,
  options,
} = Astro.props;
---

<nav class="language-switcher" aria-label={navigationLabel} lang={navigationLanguage}>
  <span
    class="language-switcher__current"
    aria-current="page"
    aria-label={`${currentLanguageLabel}: ${currentLanguageName}`}
  >
    {currentShortLabel}
  </span>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.htmlLanguage}
        lang={option.htmlLanguage}
        aria-label={option.languageName}
        data-language-switch
        data-language-locale={option.locale}
      >
        {option.shortLabel}
      </a>
    ))
  }
</nav>
