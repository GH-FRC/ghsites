---
import type { AboutFrcContent } from '../content-schema';

type Partner = AboutFrcContent['partners']['items'][number];

interface Props {
  partner: Partner;
  logoAltLanguage?: string;
  nameLanguage?: string;
}

const { partner, logoAltLanguage, nameLanguage } = Astro.props;
---

{
  partner.logo ? (
    <img
      src={partner.logo.src}
      alt={partner.logo.alt}
      lang={logoAltLanguage}
      width={partner.logo.intrinsicWidth}
      height={partner.logo.intrinsicHeight}
      loading="lazy"
    />
  ) : (
    <span lang={nameLanguage}>{partner.name}</span>
  )
}
