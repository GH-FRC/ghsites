---
import PlaceholderBlock from './PlaceholderBlock.astro';
import LocalizedMedia from './LocalizedMedia.astro';
import type { LocalizedMedia as LocalizedMediaContent } from '../content-schema';

interface Props {
  title: string;
  introPlaceholder: string;
  mediaPlaceholder: string;
  media?: LocalizedMediaContent;
  placeholderKindLabels: {
    text: string;
    media: string;
  };
  fallbackPaths?: ReadonlySet<string>;
}

const {
  title,
  introPlaceholder,
  mediaPlaceholder,
  media,
  placeholderKindLabels,
  fallbackPaths = new Set<string>(),
} = Astro.props;
const languageFor = (path: string) => fallbackPaths.has(path) ? 'zh-CN' : undefined;
---

<section
  class="hero"
  id="page-top"
  aria-labelledby="hero-title"
  data-achievement-section="page-top"
  data-scroll-section
>
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" lang={languageFor('hero.title')}>{title}</h1>
      <PlaceholderBlock
        label={introPlaceholder}
        kind="text"
        kindLabel={placeholderKindLabels.text}
        kindLabelLanguage={languageFor('placeholderKinds.text')}
        labelLanguage={languageFor('hero.introPlaceholder')}
      />
    </div>

    <div class="hero__media">
      {
        media ? (
          <LocalizedMedia
            media={media}
            path="hero.media"
            fallbackPaths={fallbackPaths}
          />
        ) : (
          <PlaceholderBlock
            label={mediaPlaceholder}
            kind="media"
            kindLabel={placeholderKindLabels.media}
            kindLabelLanguage={languageFor('placeholderKinds.media')}
            labelLanguage={languageFor('hero.mediaPlaceholder')}
          />
        )
      }
    </div>
  </div>

  <div class="hero__index" aria-hidden="true">
    <span>GHFRC</span>
    <span>01</span>
  </div>
</section>
