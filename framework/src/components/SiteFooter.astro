---
interface Props {
  title: string;
  placeholder: string;
}

const { title, placeholder } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__title">{title}</p>
    <p class="site-footer__placeholder">{placeholder}</p>
  </div>
</footer>
