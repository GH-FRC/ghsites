---
import type { SiteContent } from '../content-schema';
import {
  htmlLanguageForLocale,
  SUPPORTED_LOCALES,
  type Locale,
} from '../i18n/locales';
import { buildLanguageSwitchPath } from '../scripts/language-preference';
import {
  buildSiteNavigationItems,
  sitePagePlan,
  type SiteNavigationContext,
} from '../site-structure';

import SiteHeader from './SiteHeader.astro';

interface Props {
  context: SiteNavigationContext;
  currentPath: string;
  fallbackPaths: ReadonlySet<string>;
  locale: Locale;
  site: SiteContent;
}

const { context, currentPath, fallbackPaths, locale, site } = Astro.props;
const navigationItems = buildSiteNavigationItems(site.navigation, context, locale).map(
  (item, index) => ({
    ...item,
    language: fallbackPaths.has(`navigation.${sitePagePlan[index].id}`)
      ? 'zh-CN'
      : undefined,
  }),
);
const languageOptions = SUPPORTED_LOCALES
  .filter((optionLocale) => optionLocale !== locale)
  .map((optionLocale) => ({
    href: buildLanguageSwitchPath(optionLocale, currentPath),
    htmlLanguage: htmlLanguageForLocale(optionLocale),
    locale: optionLocale,
    languageName: site.languageSwitcher.options[optionLocale],
    shortLabel: site.languageSwitcher.shortOptions[optionLocale],
  }));
const isHome = context === 'home';
const homeLinkKey = isHome ? 'returnToTop' : 'returnToHome';
---

<SiteHeader
  logo={site.logo}
  navigationItems={navigationItems}
  mainNavigationLabel={site.accessibility.mainNavigation}
  homeLinkLabel={site.accessibility[homeLinkKey]}
  switchToDarkModeLabel={site.accessibility.switchToDarkMode}
  switchToLightModeLabel={site.accessibility.switchToLightMode}
  mainNavigationLanguage={
    fallbackPaths.has('accessibility.mainNavigation') ? 'zh-CN' : undefined
  }
  homeLinkLanguage={fallbackPaths.has(`accessibility.${homeLinkKey}`) ? 'zh-CN' : undefined}
  logoAltLanguage={fallbackPaths.has('logo.alt') ? 'zh-CN' : undefined}
  colorSchemeControlLanguage={
    fallbackPaths.has('accessibility.switchToDarkMode') ||
    fallbackPaths.has('accessibility.switchToLightMode')
      ? 'zh-CN'
      : undefined
  }
  languageSwitcher={{
    currentLanguageLabel: site.languageSwitcher.currentLanguage,
    currentLanguageName: site.languageSwitcher.options[locale],
    currentShortLabel: site.languageSwitcher.shortOptions[locale],
    navigationLabel: site.accessibility.languageNavigation,
    navigationLanguage: fallbackPaths.has('accessibility.languageNavigation')
      ? 'zh-CN'
      : undefined,
    options: languageOptions,
  }}
  homeHref={isHome ? '#page-top' : `/${locale}/`}
/>
