---
import { createLanguageRedirectScript } from '../scripts/language-preference';

interface Props {
  pagePath?: string;
}

const { pagePath = '' } = Astro.props;
const normalizedPagePath = pagePath ? `${pagePath.replace(/^\/+|\/+$/g, '')}/` : '';
const englishHref = `/en/${normalizedPagePath}${Astro.url.search}${Astro.url.hash}`;
const simplifiedChineseHref = `/zh-cn/${normalizedPagePath}${Astro.url.search}${Astro.url.hash}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="light dark" />
    <title>Choose language | 选择语言</title>
    <script is:inline set:html={createLanguageRedirectScript()}></script>
  </head>
  <body>
    <main>
      <h1>Choose language</h1>
      <p lang="zh-CN">选择语言</p>
      <nav aria-label="Language selection">
        <a href={englishHref} lang="en" hreflang="en">English</a>
        <a href={simplifiedChineseHref} lang="zh-CN" hreflang="zh-CN">简体中文</a>
      </nav>
    </main>
  </body>
</html>

<style>
  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    padding: 24px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    place-items: center;
  }

  main {
    text-align: center;
  }

  h1,
  p {
    margin: 0;
  }

  p {
    margin-top: 4px;
  }

  nav {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 24px;
  }

  a {
    color: inherit;
  }
</style>
