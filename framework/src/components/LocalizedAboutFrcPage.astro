---
import AboutFrcPage from './AboutFrcPage.astro';
import LocalizedSiteHeader from './LocalizedSiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadLocalizedWebsiteContent } from '../i18n/content-loader';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const localizedContent = await loadLocalizedWebsiteContent(locale);
const site = localizedContent.site.content;
const aboutFrc = localizedContent.aboutFrc.content;
---

<BaseLayout
  title={aboutFrc.meta.title}
  description={aboutFrc.meta.description}
  locale={locale}
  pagePath="about-frc"
  noIndex={locale === 'en' && !localizedContent.isEnglishComplete}
  titleLanguage={
    localizedContent.aboutFrc.fallbackPaths.has('meta.title') ? 'zh-CN' : undefined
  }
  descriptionLanguage={
    localizedContent.aboutFrc.fallbackPaths.has('meta.description') ? 'zh-CN' : undefined
  }
>
  <LocalizedSiteHeader
    context="about-frc"
    fallbackPaths={localizedContent.site.fallbackPaths}
    locale={locale}
    site={site}
  />

  <AboutFrcPage
    content={aboutFrc}
    homeHref={`/${locale}/`}
    fallbackPaths={localizedContent.aboutFrc.fallbackPaths}
  />
  <SiteFooter
    title={site.footer.title}
    placeholder={site.footer.placeholder}
    titleLanguage={localizedContent.site.fallbackPaths.has('footer.title') ? 'zh-CN' : undefined}
    placeholderLanguage={
      localizedContent.site.fallbackPaths.has('footer.placeholder') ? 'zh-CN' : undefined
    }
  />

  <script>
    import { initializeSiteInteractions } from '../scripts/site-interactions';

    initializeSiteInteractions();
  </script>
</BaseLayout>
