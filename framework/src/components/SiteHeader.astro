---
import NavigationList from './NavigationList.astro';

interface NavigationItem {
  target: string;
  label: string;
}

interface Props {
  logo: {
    src: string;
    alt: string;
    intrinsicWidth: number;
    intrinsicHeight: number;
  };
  navigationItems: NavigationItem[];
  mainNavigationLabel: string;
  returnToTopLabel: string;
  switchToDarkModeLabel: string;
  switchToLightModeLabel: string;
}

const {
  logo,
  navigationItems,
  mainNavigationLabel,
  returnToTopLabel,
  switchToDarkModeLabel,
  switchToLightModeLabel,
} = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <button
      class="site-header__menu-toggle"
      type="button"
      aria-label={mainNavigationLabel}
      aria-controls="compact-navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <a
      class="site-header__brand"
      href="#page-top"
      aria-label={returnToTopLabel}
      data-home-link
    >
      <img
        src={logo.src}
        alt={logo.alt}
        width={logo.intrinsicWidth}
        height={logo.intrinsicHeight}
      />
    </a>

    <nav class="site-header__navigation" aria-label={mainNavigationLabel}>
      <NavigationList navigationItems={navigationItems} />
    </nav>

    <div class="site-header__utility">
      <button
        class="site-header__color-scheme-toggle"
        type="button"
        aria-label={switchToDarkModeLabel}
        data-color-scheme-toggle
        data-switch-to-dark-label={switchToDarkModeLabel}
        data-switch-to-light-label={switchToLightModeLabel}
      >
        <svg
          class="site-header__color-scheme-icon site-header__color-scheme-icon--moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8a8.5 8.5 0 1 0 11.3 11.3Z"></path>
        </svg>
        <svg
          class="site-header__color-scheme-icon site-header__color-scheme-icon--sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    class="site-header__compact-navigation"
    id="compact-navigation"
    aria-label={mainNavigationLabel}
    data-compact-menu
    hidden
  >
    <NavigationList navigationItems={navigationItems} />
  </nav>
</header>
