---
import ContentSection from './ContentSection.astro';
import HeroSection from './HeroSection.astro';
import LocalizedSiteHeader from './LocalizedSiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadLocalizedWebsiteContent } from '../i18n/content-loader';
import { htmlLanguageForLocale, type Locale } from '../i18n/locales';
import { siteSectionPlan } from '../site-structure';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const localizedContent = await loadLocalizedWebsiteContent(locale);
const site = localizedContent.site.content;
---

<BaseLayout
  title={site.title}
  description={site.description}
  locale={locale}
  noIndex={locale === 'en' && !localizedContent.isEnglishComplete}
  achievementUnlockedMessage={site.achievementMessages.unlocked}
  achievementUnlockedLanguage={
    localizedContent.site.fallbackPaths.has('achievementMessages.unlocked')
      ? 'zh-CN'
      : htmlLanguageForLocale(locale)
  }
  titleLanguage={localizedContent.site.fallbackPaths.has('title') ? 'zh-CN' : undefined}
  descriptionLanguage={
    localizedContent.site.fallbackPaths.has('description') ? 'zh-CN' : undefined
  }
>
  <LocalizedSiteHeader
    context="home"
    fallbackPaths={localizedContent.site.fallbackPaths}
    locale={locale}
    site={site}
  />

  <main>
    <HeroSection
      title={site.hero.title}
      introPlaceholder={site.hero.introPlaceholder}
      mediaPlaceholder={site.hero.mediaPlaceholder}
      media={site.hero.media}
      placeholderKindLabels={site.placeholderKinds}
      fallbackPaths={localizedContent.site.fallbackPaths}
    />

    {
      siteSectionPlan.map((section) => (
        <ContentSection
          id={section.id}
          index={section.index}
          variant={section.variant}
          content={site.sections[section.id]}
          placeholderKindLabels={site.placeholderKinds}
          fallbackPaths={localizedContent.site.fallbackPaths}
        />
      ))
    }
  </main>

  <SiteFooter
    title={site.footer.title}
    placeholder={site.footer.placeholder}
    titleLanguage={localizedContent.site.fallbackPaths.has('footer.title') ? 'zh-CN' : undefined}
    placeholderLanguage={
      localizedContent.site.fallbackPaths.has('footer.placeholder') ? 'zh-CN' : undefined
    }
  />

  <script>
    import { initializeOptionalAchievementSystem } from '../scripts/optional-achievements';
    import { initializeSiteInteractions } from '../scripts/site-interactions';

    const notificationText = document.documentElement.dataset.achievementUnlockedMessage;
    const notificationLanguage = document.documentElement.dataset.achievementUnlockedLanguage;

    void initializeOptionalAchievementSystem(undefined, {
      notificationLanguage,
      notificationText,
    });
    initializeSiteInteractions();
  </script>
</BaseLayout>
